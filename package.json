{
  "name": "ui-reference-replication",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Token-efficient visual UI implementation with evidence, regression, responsive, performance, dependency-security, and quality-report gates",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-skill.mjs",
    "plan:task": "node skills/ui-reference-replication/scripts/plan-task.mjs",
    "validate:visual-evidence": "node skills/ui-reference-replication/scripts/validate-visual-evidence.mjs",
    "validate:tokens": "node skills/ui-reference-replication/scripts/validate-tokens.mjs skills/ui-reference-replication/templates/design-tokens.example.json",
    "regression": "node skills/ui-reference-replication/scripts/run-functional-regression.mjs",
    "compare:regression": "node skills/ui-reference-replication/scripts/compare-regression.mjs",
    "validate:visual-review": "node skills/ui-reference-replication/scripts/validate-visual-review.mjs",
    "responsive:audit": "node skills/ui-reference-replication/scripts/run-responsive-audit.mjs",
    "performance:audit": "node skills/ui-reference-replication/scripts/run-performance-audit.mjs",
    "security:audit": "node skills/ui-reference-replication/scripts/run-dependency-audit.mjs",
    "validate:quality-report": "node skills/ui-reference-replication/scripts/validate-quality-report.mjs"
  }
}
