{
  "schemaVersion": "1.0.0",
  "baseUrl": "http://localhost:3000",
  "timeoutMs": 10000,
  "checks": [
    {
      "id": "dashboard-load",
      "route": "/dashboard",
      "expectedStatus": 200,
      "steps": [
        { "action": "expect-visible", "selector": "main" },
        { "action": "expect-visible", "selector": "[data-testid=dashboard-title]" }
      ]
    },
    {
      "id": "login-invalid-credentials",
      "route": "/login",
      "expectedStatus": 200,
      "steps": [
        { "action": "fill", "selector": "input[name=email]", "value": "invalid@example.test" },
        { "action": "fill", "selector": "input[name=password]", "value": "invalid-password" },
        { "action": "click", "selector": "button[type=submit]" },
        { "action": "expect-visible", "selector": "[role=alert]" }
      ]
    }
  ]
}
